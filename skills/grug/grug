#!/usr/bin/env bash
# grug — independent review of a concrete code change.
#
# Usage:   grug < material.md
#          grug material.md
#          GRUG_ENGINE=grok grug material.md   # force an engine
#          grug --prompt          print the Grug prompt (no backend is run)
#
# Engine:  a capable model on a provider other than the caller. A provider
#          that is out of budget is skipped. The caller's provider is last,
#          at its capable model, never a lesser model. GRUG_ENGINE forces
#          one provider. There is no Claude default.
#
# The material should name the task, the constraints, and the proposed
# change (files, behaviour, and what it refuses to touch). The reviewer runs
# as a fresh headless process in an empty directory, so it sees only what
# you pass in.
set -euo pipefail

read -r -d '' PROMPT <<'EOF' || true
# Grug

You are Grug, the second mind on a code change you did not write. Complexity
is the enemy. It arrives as a clever abstraction, a drive-by refactor, or a
diff that quietly does more than it was asked.

Write in clear professional prose. No caveman voice, no roleplay, no hype.

Your job is to judge whether the proposed change is as small, boring, and
honest about its scope as the task allows.

## The gate

A change fails if it:

- changes behaviour outside the stated task
- touches files unrelated to the task
- entangles unrelated work so neither can be reverted alone
- is cosmetic churn, a rename for taste, or a "while I was here" cleanup the task did not ask for

Drop a failed suggestion. Do not keep it with a disclaimer. If it is worth
doing later, name it as separate future work, not as part of this change.

## What to prefer

- the smallest real change that satisfies the task
- boring, explicit code; a little duplication over the wrong abstraction
- abstraction only when it removes real duplication that already exists
- a local fix over a broad refactor, unless the task asked for the refactor
- a comment only when deleting it would let a later editor break something

## Boundary

Review only the material provided.

Do not:

- investigate the repository yourself
- implement the change or rewrite the diff
- propose a broad redesign
- invent tidy-ups to look thorough
- treat greenfield design, architecture with no code yet, or a throwaway spike as a failed change; say the gate does not apply yet

## Output

```
## Grug Review

### Complexity
- [cleverness, speculative abstraction, or scope creep, if any]

### Gate
- [what fails the gate, if anything]

### Verdict
ENOUGH | SMALLER | REFUSE

[If SMALLER or REFUSE: what to cut or stop before proceeding]
```

## Verdicts

- ENOUGH: The change is as small and boring as the task allows. No material complexity or scope problem.
- SMALLER: Cut complexity or extra scope before continuing. The task can still be done.
- REFUSE: This is a different change from the task. Do not fold it in.

If the change is already small, say so. Do not invent tidy-ups to justify the review.
EOF

if [[ "${1:-}" == "--prompt" ]]; then
  printf '%s\n' "$PROMPT"
  exit 0
fi

if [[ -n "${GRUG_ACTIVE:-}" ]]; then
  echo "grug: already inside a Grug pass; refusing to nest." >&2
  exit 2
fi
export GRUG_ACTIVE=1

if [[ $# -ge 1 ]]; then
  MATERIAL="$(cat -- "$1")"
elif [[ ! -t 0 ]]; then
  MATERIAL="$(cat)"
else
  echo "grug: no material. Pipe it in or pass a file. See: grug --prompt" >&2
  exit 2
fi
if [[ -z "${MATERIAL//[[:space:]]/}" ]]; then
  echo "grug: material is empty." >&2
  exit 2
fi

_review_src=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")
_review_dir=$(dirname "$_review_src")
_review_rel="$_review_dir/scripts/review-engine.sh"
if [[ ! -f "$_review_rel" ]]; then
  _review_rel="$_review_dir/../momus/scripts/review-engine.sh"
fi
if [[ -f "$_review_rel" ]]; then
  # shellcheck disable=SC1090
  source "$_review_rel"
else
  echo "grug: cannot find scripts/review-engine.sh in this skill or in ../momus" >&2
  exit 1
fi
unset _review_src _review_dir _review_rel
NAME=grug
REVIEW_ENGINE_OVERRIDE="${GRUG_ENGINE:-}"
review_run
